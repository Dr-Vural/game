# Varsayılan güvenlik başlıkları
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: connect-src 'self' https://vumatech-proxy.vuraloglu.workers.dev https://api.codetabs.com https://api.mymemory.translated.net https://labs.vumatech.net

# Statik dosyalar için uzun önbellek (versiyonlu yüklenirler)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

# HTML sayfası — kısa önbellek (güncellemeler görünsün)
/
  Cache-Control: public, max-age=300, must-revalidate

/index.html
  Cache-Control: public, max-age=300, must-revalidate
